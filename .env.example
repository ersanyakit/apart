APP_ENV=development
APP_URL=http://localhost:3000
# Geçici HTTPS adresi: go run . tunnel (cloudflared kurulu olmalı).
# Kalıcı Cloudflare tüneli: APP_URL=https://otel.example.com ve go run .
# Cloudflare Service hedefi Go PORT değeridir; UI_PORT değildir.
BIND_HOST=127.0.0.1
PORT=3000
UI_PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/interactiveotel?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-bytes
DATA_DIR=data
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
HOTEL_NAME=INTERACTIVEOTEL

# Public marketing contact details. The contact form opens an email draft.
MARKETING_CONTACT_EMAIL=
MARKETING_CONTACT_PHONE=
MARKETING_CONTACT_ADDRESS=
