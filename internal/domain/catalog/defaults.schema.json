{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mandatory hotel catalog seed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "categories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    }
  },
  "$defs": {
    "label": {
      "type": "object",
      "required": [
        "TR",
        "EN"
      ],
      "propertyNames": {
        "pattern": "^[A-Z]{2,3}(-[A-Z]{2,4})?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000,
        "pattern": "\\S"
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "icon_key",
        "sort_order",
        "groups"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "icon_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "sort_order": {
          "type": "integer",
          "minimum": 1
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "entries"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "kind",
        "scope",
        "icon_key",
        "sort_order"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^catalog\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "kind": {
          "enum": [
            "amenity",
            "inventory",
            "consumable"
          ]
        },
        "scope": {
          "enum": [
            "room",
            "property"
          ]
        },
        "icon_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "sort_order": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
